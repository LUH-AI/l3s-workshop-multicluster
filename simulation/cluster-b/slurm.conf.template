## Cluster B slurm.conf TEMPLATE ("## " lines are dropped). create.sh fills in the @...@ placeholders and
## writes the result to generated/slurm.conf, which every container reads at start.
ClusterName=cluster-b
SlurmctldHost=slurmctld
SlurmUser=root
SlurmdUser=root
AuthType=auth/munge
MpiDefault=none

# Containers: no cgroup plugins, plain /proc process tracking.
ProctrackType=proctrack/linuxproc
TaskPlugin=task/none
# slurmd sees all host CPUs/memory inside a container; trust this file instead.
SlurmdParameters=config_overrides

SchedulerType=sched/backfill
# Without accounting, 23.11.4's main scheduler skips every pending job with
# reason "InvalidAccount" (its association list never gets initialised), so only
# the backfill scheduler starts jobs. Run it every second instead of every 30 s;
# jobs then start about 5 s after submission or after a slot frees up.
SchedulerParameters=bf_interval=1
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
ReturnToService=2

# No accounting (leaving AccountingStorageType unset; the "none" plugin is gone in 23.11).
JobAcctGatherType=jobacct_gather/none
JobCompType=jobcomp/none

StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldPidFile=/run/slurmctld.pid
SlurmdPidFile=/run/slurmd.pid
SlurmctldTimeout=60
SlurmdTimeout=60
InactiveLimit=0
MinJobAge=300
KillWait=10
Waittime=0

# Compute nodes (generated).
@NODE_LINES@

PartitionName=calc Nodes=@NODE_LIST@ Default=YES MaxTime=10 DefMemPerCPU=@DEF_MEM_PER_CPU@ State=UP
